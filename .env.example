# Copie para .env e preencha só o que for usar. Nada aqui é obrigatório para rodar localmente.

# Banco. Vazio = PGlite em disco (PGLITE_DATA_DIR). Em produção, a connection string do Supabase/Postgres.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# LLM opcional. Sem chave, o score é só determinístico e os rascunhos vêm dos templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Peso do LLM na média com o score determinístico (0 a 1).
LLM_WEIGHT=0.3

# Piso salarial mensal em reais. Vazio = filtro de salário desligado.
SALARY_FLOOR_BRL=

# Alerta opcional no Telegram para vagas novas com score >= 80.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: aumenta o limite da API do GitHub (no Actions, o GITHUB_TOKEN já é injetado).
GITHUB_TOKEN=

# Protege o painel com senha (Basic Auth). Opcional localmente, obrigatória na Vercel.
DASHBOARD_PASSWORD=
